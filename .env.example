# Elasticsearch connection
ES_URL=http://localhost:9200
# For Elastic Cloud / secured clusters, set the base64-encoded API key (leave blank for local, unsecured ES)
ES_API_KEY=
ES_SESSIONS_INDEX=conference_sessions
ES_INFO_INDEX=conference_info

# Conference data sources
SCHEDULE_URL=https://events.linuxfoundation.org/kubecon-cloudnativecon-north-america/program/schedule/
PAVILION_URL=https://events.linuxfoundation.org/kubecon-cloudnativecon-north-america/features-add-ons/project-engagement/

# Local cache dir for fetched HTML (avoids hammering the source while developing)
CACHE_DIR=.cache

# Helpdesk agent (System 2) -- Elastic Agent Builder (no provider key needed)
# KIBANA_URL is the Kibana endpoint of your cluster; reuses ES_API_KEY for auth.
KIBANA_URL=
AGENT_ID=elastic-ai-agent
